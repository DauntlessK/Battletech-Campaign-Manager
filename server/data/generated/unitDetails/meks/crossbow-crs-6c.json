      "chassis": "Arc Walker 6X-B",
      "engine": "AA Eterna 300",
      "armor": "Diamond Skin Beta Series",
      "jumpjet": "Unknown",
      "communications": "Arc Signal 1100",
      "targeting": "Arc Walker T&T Prime"
    }
